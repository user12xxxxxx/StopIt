# Allowlist: everything at the top level is ignored except what the build and the repo need.
# Add a path here (with !) before committing a new top-level file or folder.
/*
!/.gitignore
!/LICENSE
!/README.md
!/licenses/
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradle/
!/gradlew
!/gradlew.bat

# The app module: its build file and sources only.
!/app/
/app/*
!/app/build.gradle.kts
!/app/src/

# Never committed, even inside allowed folders.
.DS_Store
*.iml
